DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
JWT_SECRET=

# For Supabase/Postgres deployments, use this instead of the DB_* MySQL values.
DATABASE_URL=
# Optional aliases also supported:
SUPABASE_DATABASE_URL=
SUPABASE_DB_URL=
POSTGRES_SSL=true

# Supabase API fallback. Prefer SUPABASE_SERVICE_ROLE_KEY on the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
